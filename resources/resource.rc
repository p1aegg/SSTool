#include <windows.h>
#include "../src/resource.h"

IDR_MANIFEST RT_MANIFEST  "app.manifest"

IDR_HTML_INDEX  RCDATA    "../web/index.html"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     1,0,0,0
PRODUCTVERSION  1,0,0,0
FILEFLAGSMASK   0x3fL
FILEFLAGS       0x0L
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "p1ae"
            VALUE "FileDescription",  "SSTool - p1ae"
            VALUE "FileVersion",      "1.0.0"
            VALUE "InternalName",     "SSTool"
            VALUE "OriginalFilename", "SSTool.exe"
            VALUE "ProductName",      "SSTool"
            VALUE "ProductVersion",   "1.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
